# ============================================================
# Z CAFÉ - Environment Configuration Template
# Copy this file to .env.local for local development
# ============================================================

# --- RAZORPAY PAYMENT GATEWAY (Indian Gateway) ---
# Obtain from https://dashboard.razorpay.com/app/keys (Test or Live mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# --- FIREBASE CLIENT (Optional for live Firestore sync) ---
# If omitted, the app automatically runs in seamless local synchronization mode!
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=z-cafe-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=z-cafe-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=z-cafe-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- FIREBASE ADMIN SDK (For Server Functions & Seeds) ---
FIREBASE_PROJECT_ID=z-cafe-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@z-cafe-app.iam.gserviceaccount.com
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# --- KITCHEN / ADMIN DASHBOARD ---
# PIN used to unlock /admin kitchen board
KITCHEN_ADMIN_PIN=7777

# --- PUBLIC URL ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
